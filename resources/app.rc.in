// Generated by CMake from resources/app.rc.in — do not edit the generated copy.
// Version fields come from PROJECT_VERSION so a release bump only ever happens
// in CMakeLists.txt.

#include <winver.h>

IDI_ICON1 ICON "@ISO_APP_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "KaroqDave"
            VALUE "FileDescription", "ISO Integrity Check"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "iso-integrity-check"
            VALUE "LegalCopyright", "Copyright (C) 2026 KaroqDave"
            VALUE "OriginalFilename", "iso-integrity-check.exe"
            VALUE "ProductName", "ISO Integrity Check"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
